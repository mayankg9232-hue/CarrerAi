# Application Configuration
APP_NAME="AI Job Matcher"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Security & Authentication (Generate secure secret for production)
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
GITHUB_TOKEN=

# Firebase Authentication (Optional client integration)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=aihiring-3d070.firebaseapp.com
FIREBASE_PROJECT_ID=aihiring-3d070
FIREBASE_STORAGE_BUCKET=aihiring-3d070.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=14319993219
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
AUTH_PROVIDER=hybrid

# Database (SQLite default for MVP)
DATABASE_URL=sqlite+aiosqlite:///./app_dev.db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000

# LLM Providers (Introduced in Phase 4 - Keep empty in git)
PRIMARY_LLM_PROVIDER=openai
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_MODEL=gpt-4o-mini
SECONDARY_LLM_PROVIDER=gemini
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_MODEL=gemini-1.5-flash

# Embeddings (Gemini Embedding 2 / Local)
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2

# Firecrawl & Job Ingestion (Phase 3)
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
APPROVED_JOB_DOMAINS=approved-board.example.com,careers.techcompany.com
STALE_JOB_DAYS_THRESHOLD=30

# Resume Processing (Phase 3)
ALLOWED_CV_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
MAX_CV_SIZE_BYTES=5242880

# Agent Orchestration Limits (Phase 6)
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SECONDS=90

# Sandbox Code Execution (Phases 7 & 8)
SANDBOX_PROVIDER=mock
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_MB=128
